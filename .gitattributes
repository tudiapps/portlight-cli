# Same rules as the monorepo root, so the public mirror (tools/publish-cli.sh)
# keeps them: LF everywhere, CRLF for Windows scripts. The PuTTY test vectors
# must stay LF on every checkout, Windows CI included.
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# A local double-click helper; not part of the published source.
run_pair.bat export-ignore
